      "magic": "jpg"
    },
    "background": {
      "file": "background.png",
      "magic": [
        "png",
        "jpg"
      ]
    },
    "portrait-src-left": {
      "file": "portrait-src-left.png",
      "magic": [
        "png",
        "jpg"
      ]
    },
    "portrait-src-right": {
      "file": "portrait-src-right.png",
      "magic": [
        "png",
        "jpg"
      ]
    }
  },
  "overlays": {
    "hud": "overlays/hud",
    "cta": "overlays/cta",
    "intro": "overlays/intro",
    "background": "overlays/background",
    "analytics": "overlays/analytics"
  },
  "level": {
    "assetPath": "level.json"
  },
  "background": {
    "width": 1560,
    "height": 2598,
