    "intro": { "enabled": false, "ariaLabel": "" },
    "outro": { "enabled": false },
    "hud": { "enabled": false, "titleEnabled": null, "titleLine1": "", "titleLine2": "", "ariaLabel": "" },
    "background": { "enabled": false, "blurSigma": 12, "source": "auto" },
    "hudImageSource": { "left": "upload", "right": "upload" },
    "patternId": "cat"
