{
  "id": "word-search-explorer-origin",
  "name": "Word Search Explorer（片头+原版网格找词）",
  "template": "word-search-explorer-origin",
  "workbench": "word-search-explorer-origin",
  "steps": [
    {
      "id": "intro",
      "runner": "core:intro"
    },
    {
      "id": "pack",
      "runner": "./steps/pack.mjs"
    }
  ],
  "uploads": {
    "intro-video": {
      "file": "intro-video.mp4",
      "magic": "mp4"
    },
    "intro-poster": {
      "file": "intro-poster.jpg",
      "magic": "jpg"
    }
  },
  "overlays": {
    "hud": "overlays/hud"
  },
  "level": {
    "min": 1,
    "max": 1
  },
  "defaults": {
    "levelId": 1,
    "gameplay": {
      "allowReplay": false
    },
    "playableCta": {
      "enabled": true,
      "mode": "steps",
      "afterSteps": 4,
      "intervals": [4, 3, 2]
    },
    "hud": {
      "enabled": false,
      "titleEnabled": false,
      "titleLine1": "Word Search Explorer",
      "titleLine2": "Find every hidden word",
      "ariaLabel": ""
    },
    "intro": {
      "enabled": false,
      "ariaLabel": ""
    },
    "cta": {
      "enabled": true,
      "endMask": false,
      "buttonText": "Play Now",
      "guideText": "Enjoy for free"
    }
  }
}
