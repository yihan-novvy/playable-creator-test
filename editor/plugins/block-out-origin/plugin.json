{
  "id": "block-out-origin",
  "name": "Block Out! - Color Sort Puzzle（片头+原版试玩）",
  "template": "block-out-origin",
  "workbench": "block-out-origin",
  "steps": [
    { "id": "intro", "runner": "core:intro" },
    { "id": "pack", "runner": "./steps/pack.mjs" }
  ],
  "uploads": {
    "intro-video": { "file": "intro-video.mp4", "magic": "mp4" },
    "intro-poster": { "file": "intro-poster.jpg", "magic": "jpg" }
  },
  "overlays": { "hud": "overlays/hud", "engine": "overlays/engine" },
  "defaults": {
    "hud": { "enabled": false, "titleEnabled": false, "titleLine1": "Block Out", "titleLine2": "Slide blocks to matching exits", "ariaLabel": "" },
    "intro": { "enabled": false, "ariaLabel": "", "goEnabled": false, "goText": "GO" },
    "cta": { "endMask": false },
    "gameplay": { "allowReplay": false },
    "playableCta": { "mode": "steps", "afterSteps": 20, "intervals": [10, 8, 6, 4] }
  }
}
