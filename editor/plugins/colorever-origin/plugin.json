{
  "id": "colorever-origin",
  "name": "Colorever Origin（5瓣花片头+试玩）",
  "template": "colorever-origin",
  "workbench": "colorever-origin",
  "steps": [
    { "id": "intro", "runner": "core:intro" },
    { "id": "pack", "runner": "./steps/pack.mjs" }
  ],
  "uploads": {
    "intro-video": { "file": "intro-video.mp4", "magic": "mp4" },
    "intro-poster": { "file": "intro-poster.jpg", "magic": "jpg" }
  },
  "overlays": {
    "hud": "overlays/hud",
    "engine": "overlays/engine"
  },
  "defaults": {
    "hud": {
      "enabled": false,
      "titleEnabled": true,
      "titleLine1": "Colorever",
      "titleLine2": "The Best Brain-Training Game",
      "ariaLabel": ""
    },
    "intro": {
      "enabled": false,
      "ariaLabel": "",
      "goEnabled": false,
      "goText": "GO"
    },
    "cta": {
      "endMask": false
    },
    "playableCta": {
      "mode": "steps",
      "afterSteps": 10,
      "intervals": [5, 4, 3, 2]
    }
  }
}
