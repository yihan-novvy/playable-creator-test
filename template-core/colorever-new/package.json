{
  "name": "colorever-new-three-playable",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "node scripts/build-template.mjs --out ../../editor/templates/colorever-new/game",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test tests/*.test.js",
    "build:offline": "node scripts/build-offline.mjs",
    "build:game": "node scripts/build-template.mjs",
    "build:template": "node scripts/build-template.mjs --out ../../editor/templates/colorever-new/game",
    "editor": "vite --host 127.0.0.1 --port 5175 --strictPort --open /editor/",
    "build:preview": "vite build"
  },
  "dependencies": {
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "vite": "^7.1.0"
  }
